{
  "name": "supermarkt-app",
  "version": "1.0.0",
  "description": "Rezepte aus Supermarkt-Angeboten",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run build:server && AUTH_MODE=dev node dist-server/server.mjs",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild worker/server.ts worker/compare.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist-server --out-extension:.js=.mjs --packages=external --log-level=warning",
    "start": "node dist-server/server.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json",
    "test": "esbuild test/normalize.test.ts --bundle --platform=node --log-level=warning | node"
  },
  "dependencies": {
    "postgres": "3.4.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "esbuild": "^0.23.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5"
  },
  "private": true,
  "type": "module"
}
