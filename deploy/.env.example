# Kopieren nach .env und ausfüllen. Geheime Werte z. B. mit `openssl rand -base64 36 | tr -d '\n'` erzeugen.

# --- Domains (beide in Cloudflare mit oranger Wolke, HTTPS über das Origin-Zertifikat in certs/) ---
APP_DOMAIN=app.mattis-kraemer.de
AUTH_DOMAIN=auth.mattis-kraemer.de

# --- Datenbank ---
AUTHENTIK_DB_PASSWORD=
APP_DB_PASSWORD=

# --- Authentik ---
AUTHENTIK_SECRET_KEY=
# Version von Authentik (vor einem Update die Release Notes lesen)
AUTHENTIK_TAG=2026.8.3

# --- E-Mail-Versand (Einladungen, Passwort vergessen) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM=Angebotsküche <noreply@mattis-kraemer.de>

# --- KI über OpenRouter ---
OPENROUTER_API_KEY=
# Rezepte
RECIPE_MODEL=deepseek/deepseek-v4.1-flash
# Schnell-Modus der Rezepte (leer = RECIPE_MODEL)
RECIPE_MODEL_FAST=
# Prospektseiten lesen (muss Bilder verstehen). Erst nach dem Modellvergleich eintragen, siehe deploy/README.md
EXTRACT_MODEL=

# --- Kostengrenzen (US-Dollar) ---
# Notbremse für alle zusammen pro Monat
MONTHLY_BUDGET_USD=8
# Pro Konto und Tag, wenn in Authentik kein ki_budget_tag_usd hinterlegt ist
DAILY_USER_BUDGET_USD=0.10
# Höchstens so viele automatische Prospekt-Einlesungen pro Woche (alle Märkte zusammen)
EXTRACT_PER_WEEK=4

# --- EDEKA ---
# Geheimer Schlüssel für das Relay zu Hause (gleicher Wert in relay/.env)
RELAY_TOKEN=
# Zugangsdaten der EDEKA-App-Schnittstelle (client_credentials), siehe deploy/README.md
EDEKA_APP_CLIENT_ID=
EDEKA_APP_CLIENT_SECRET=
